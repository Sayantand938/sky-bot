# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
# From @BotFather -> /newbot -> the token looks like 123456789:AAE...
TELEGRAM_BOT_TOKEN=

# A random string you invent. Telegram echoes it back in the
# X-Telegram-Bot-Api-Secret-Token header so only Telegram can call your webhook.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# AI (AICredits — OpenAI-compatible)
# ---------------------------------------------------------------------------
# Your AICredits key (starts with sk-live-...)
AI_API=

# Optional overrides
AI_BASE_URL=https://api.aicredits.in/v1
AI_MODEL=deepseek/deepseek-v4.1-flash

# Her name — used in her persona and in the greeting.
BOT_NAME=Sky
# Leave this EMPTY to use Sky's built-in personality (recommended).
# Set it only if you want to replace her entire persona with your own prompt —
# doing so also disables the "keep it short / split into bubbles" instructions.
AI_SYSTEM_PROMPT=

# Messages (user + assistant) replayed as context per chat. 40 = ~20 exchanges.
# Clamped to a maximum of 50 in lib/config.ts. Raising this costs input tokens.
AI_MAX_HISTORY=40
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1024

# ---------------------------------------------------------------------------
# Durable memory (Upstash Redis, REST API) — optional but recommended
# ---------------------------------------------------------------------------
# Without these the bot remembers a conversation only inside one serverless
# instance, so a cold start forgets everything. With them, history is shared
# across instances and survives restarts.
#
# Create a free database at https://console.upstash.com/redis and copy the
# HTTPS endpoint and token from the database page. Both must be set to enable.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Days of silence before a chat's history expires. Default 14.
AI_MEMORY_TTL_DAYS=14

# ---------------------------------------------------------------------------
# Optional: locks /api/setup so only you can register the webhook.
# Send it as ?key=... or an "x-setup-key" header.
# ---------------------------------------------------------------------------
SETUP_KEY=
