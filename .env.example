# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
# From @BotFather -> /newbot -> the token looks like 123456789:AAE...
TELEGRAM_BOT_TOKEN=

# A random string you invent. Telegram echoes it back in the
# X-Telegram-Bot-Api-Secret-Token header so only Telegram can call your webhook.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# AI (AICredits — OpenAI-compatible)
# ---------------------------------------------------------------------------
# Your AICredits key (starts with sk-live-...)
AI_API=

# Optional overrides
AI_BASE_URL=https://api.aicredits.in/v1
AI_MODEL=deepseek/deepseek-v4.1-flash

# Her name — used in her persona and in the greeting.
BOT_NAME=Sky
# Leave this EMPTY to use Sky's built-in personality (recommended).
# Set it only if you want to replace her entire persona with your own prompt —
# doing so also replaces her brevity rules (the occasional split hint from
# AI_SPLIT_HINT_CHANCE is still appended on top).
AI_SYSTEM_PROMPT=

# Messages (user + assistant) replayed as context per chat. 40 = ~20 exchanges.
# Clamped to a maximum of 50 in lib/config.ts. Raising this costs input tokens.
AI_MAX_HISTORY=40
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1024

# ---------------------------------------------------------------------------
# Human texture — make her read like a person rather than a fast API
# ---------------------------------------------------------------------------
# Every artificial pause is drawn from ONE shared 10s budget per reply, so the
# values below tune the shape of the delay but cannot push a request past the
# route's 60s limit. Set the chances to 0 to disable a behaviour entirely.

# The pause before she starts typing (she noticed the message first).
AI_READ_DELAY_MIN_MS=700
AI_READ_DELAY_MAX_MS=2600

# Random extra pause before the reply is sent. This is what stops her response
# times being a metronome.
AI_REPLY_JITTER_MIN_MS=300
AI_REPLY_JITTER_MAX_MS=3200

# Chance she was busy and takes a longer pause. 0 disables it.
AI_BUSY_CHANCE=0.12
AI_BUSY_DELAY_MIN_MS=6000
AI_BUSY_DELAY_MAX_MS=18000

# Chance that one extra line is appended to her system prompt, asking her to
# mark her own message breaks with a blank line. The splitter on our side
# produces the final bubbles either way. 0 = never ask, 1 = always ask.
AI_SPLIT_HINT_CHANCE=0.5

# Chance a short, non-question message gets an emoji reaction instead of words.
AI_REACTION_CHANCE=0.1

# Window in which further messages are treated as one thought, answered once.
# 0 disables debouncing (every message then gets its own reply).
AI_DEBOUNCE_MS=2500

# How long a single model request may run. Must stay well under the route's 60s
# limit: 60s - this - bubble pacing - pauses = headroom.
AI_TIMEOUT_MS=40000

# ---------------------------------------------------------------------------
# Durable memory (Upstash Redis, REST API) — optional but recommended
# ---------------------------------------------------------------------------
# Without these the bot remembers a conversation only inside one serverless
# instance, so a cold start forgets everything. With them, history is shared
# across instances and survives restarts.
#
# Create a free database at https://console.upstash.com/redis and copy the
# HTTPS endpoint and token from the database page. Both must be set to enable.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Days of silence before a chat's history expires. Default 14.
AI_MEMORY_TTL_DAYS=14

# ---------------------------------------------------------------------------
# Optional: locks /api/setup so only you can register the webhook.
# Send it as ?key=... or an "x-setup-key" header.
# ---------------------------------------------------------------------------
SETUP_KEY=
